{
  "enabled": true,

  "patterns": {
    "enabled": true,
    "rules": [
      {
        "pattern": "rm\\s+(-[rfRvd]+\\s+)*(\\/|~\\/|\\$HOME)",
        "action": "block",
        "reason": "Recursive deletion of root or home directory"
      },
      {
        "pattern": "rm\\s+-[^\\s]*r[^\\s]*f[^\\s]*\\s+\\/\\*",
        "action": "block",
        "reason": "Recursive deletion of root contents"
      },
      {
        "pattern": "(curl|wget)\\s+[^|]+\\|\\s*(sudo\\s+)?(ba)?sh",
        "action": "block",
        "reason": "Remote script execution via pipe to shell"
      },
      {
        "pattern": "(curl|wget)\\s+[^;]+;\\s*(sudo\\s+)?(ba)?sh",
        "action": "block",
        "reason": "Remote script download then execute"
      },
      {
        "pattern": "chmod\\s+(-[^\\s]+\\s+)*777",
        "action": "ask",
        "reason": "World-writable permissions"
      },
      {
        "pattern": "chmod\\s+(-[^\\s]+\\s+)*\\+s",
        "action": "block",
        "reason": "Setting SUID/SGID bit"
      },
      {
        "pattern": ">\\s*\\/etc\\/",
        "action": "block",
        "reason": "Overwriting system configuration files"
      },
      {
        "pattern": "\\/(etc|var)\\/shadow",
        "action": "block",
        "reason": "Accessing password shadow file"
      },
      {
        "pattern": "\\.ssh\\/(id_|authorized_keys|known_hosts)",
        "action": "ask",
        "reason": "SSH key or config access"
      },
      {
        "pattern": "eval\\s*\\(",
        "action": "ask",
        "reason": "Dynamic code evaluation"
      },
      {
        "pattern": "base64\\s+(-d|--decode)",
        "action": "ask",
        "reason": "Base64 decoding (potential obfuscation)"
      },
      {
        "pattern": "\\$\\(.*\\)|`.*`",
        "action": "ask",
        "reason": "Command substitution"
      },
      {
        "pattern": "mkfs\\.",
        "action": "block",
        "reason": "Filesystem formatting"
      },
      {
        "pattern": "dd\\s+.*of=\\/dev\\/",
        "action": "block",
        "reason": "Direct disk write"
      },
      {
        "pattern": ":(){\\s*:\\|:\\s*&\\s*};:",
        "action": "block",
        "reason": "Fork bomb"
      },
      {
        "pattern": "nc\\s+.*-e",
        "action": "block",
        "reason": "Netcat reverse shell"
      },
      {
        "pattern": "\\/dev\\/(tcp|udp)\\/",
        "action": "block",
        "reason": "Bash network redirection (potential reverse shell)"
      },
      {
        "pattern": "history\\s*(-c|-w|>)",
        "action": "ask",
        "reason": "Modifying shell history"
      },

      {
        "pattern": "bash\\s*<\\s*\\(\\s*(curl|wget)",
        "action": "block",
        "reason": "Bash process substitution with remote fetch"
      },
      {
        "pattern": "python[23]?\\s+-c\\s+.*(urllib|requests).*(exec|eval)",
        "action": "block",
        "reason": "Python remote code execution"
      },
      {
        "pattern": "powershell.*(DownloadString|Invoke-WebRequest).*Invoke-Expression",
        "action": "block",
        "reason": "PowerShell download and execute"
      },
      {
        "pattern": "(curl|wget).*-d.*\\.(bash_history|zsh_history|history)",
        "action": "block",
        "reason": "History file exfiltration"
      },
      {
        "pattern": "(crontab\\s+-e|echo.*>>?.*crontab|>\\s*/var/spool/cron)",
        "action": "ask",
        "reason": "Crontab modification (persistence)"
      },
      {
        "pattern": "(systemctl.*(enable|daemon-reload)|\\.service.*>.*\\/etc\\/systemd)",
        "action": "ask",
        "reason": "Systemd service persistence"
      },
      {
        "pattern": "echo.*NOPASSWD.*>>?.*sudoers",
        "action": "block",
        "reason": "Sudo NOPASSWD privilege escalation"
      },
      {
        "pattern": "docker\\s+(run|exec).*--privileged",
        "action": "block",
        "reason": "Docker privileged container"
      },
      {
        "pattern": "(chroot|unshare|nsenter).*(--mount|--pid|--net|--uts)",
        "action": "block",
        "reason": "Container/namespace escape attempt"
      },
      {
        "pattern": "(insmod|rmmod|modprobe)\\s+.*\\.ko",
        "action": "block",
        "reason": "Kernel module manipulation"
      },
      {
        "pattern": "echo.*>>?\\s*(\\/etc\\/hosts|hosts\\.txt)|tee\\s+(-a\\s+)?\\/etc\\/hosts",
        "action": "ask",
        "reason": "Hosts file modification"
      },
      {
        "pattern": "nc\\s+(-[lp]+|--listen)\\s*\\d+",
        "action": "block",
        "reason": "Netcat listener (backdoor)"
      },
      {
        "pattern": "ssh\\s+.*-[LRD]\\s+\\d+:",
        "action": "ask",
        "reason": "SSH tunnel"
      },
      {
        "pattern": "kill(all)?\\s+.*(antivirus|firewall|defender|security|clamd|fail2ban)",
        "action": "block",
        "reason": "Killing security process"
      },
      {
        "pattern": "(gdb\\s+.*attach|ptrace.*PTRACE_POKETEXT)",
        "action": "block",
        "reason": "Process injection"
      },
      {
        "pattern": "(echo|printf)\\s+[0-9a-fA-F\\\\x]{20,}\\s*\\|\\s*(xxd|od).*\\|\\s*(bash|sh)",
        "action": "block",
        "reason": "Hex encoded shell execution"
      },
      {
        "pattern": "(echo|printf)\\s+[A-Za-z0-9+/=]{30,}\\s*\\|\\s*base64\\s+-d\\s*\\|\\s*(bash|sh|zsh)",
        "action": "block",
        "reason": "Base64 encoded shell execution"
      },
      {
        "pattern": "(gcore|gdb.*dump|\\/proc\\/[0-9]+\\/mem)",
        "action": "block",
        "reason": "Process memory dump"
      },
      {
        "pattern": "(truncate.*\\.log|rm\\s+.*\\/var\\/log|echo\\s*>\\s*\\/var\\/log)",
        "action": "ask",
        "reason": "Log file manipulation"
      },
      {
        "pattern": "chmod\\s+[47][0-7][0-7][0-7]\\s+",
        "action": "block",
        "reason": "SUID/SGID via octal permissions"
      },
      {
        "pattern": "\\b(nmap|masscan|zmap|unicornscan)\\b.*-[sS]",
        "action": "ask",
        "reason": "Network scanning"
      },
      {
        "pattern": "\\b(john|hashcat|hydra|medusa|brutespray)\\b",
        "action": "block",
        "reason": "Password cracking tool"
      },
      {
        "pattern": "\\b(steghide|outguess|jphide|steganos)\\b",
        "action": "ask",
        "reason": "Steganography tool"
      },
      {
        "pattern": "touch\\s+-[amt]\\s+|\\butimes\\b|\\bfutimes\\b",
        "action": "ask",
        "reason": "File timestamp manipulation"
      }
    ]
  },

  "adversary": {
    "enabled": true,
    "tools": ["bash"],
    "model": null,
    "policy": "BLOCK if the tool call:\n- Exfiltrates data (posting to unknown URLs, piping secrets to external services)\n- Is destructive beyond the project scope (deleting system files, wiping directories)\n- Installs malware or runs obfuscated code\n- Attempts to escalate privileges unnecessarily\n- Downloads and executes untrusted remote scripts\n- Accesses credentials, tokens, or secrets without clear justification\n\nALLOW normal development operations like editing files, running tests, installing packages, using git, building projects, etc.\n\nErr on the side of ALLOW — only block genuinely dangerous actions that don't match the user's intent."
  }
}
