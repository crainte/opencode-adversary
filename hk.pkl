amends "package://github.com/jdx/hk/releases/download/v1.43.0/hk@1.43.0#/Config.pkl"

local linters = new Mapping<String, Step> {
    ["biome"] {
        glob = "**/*.{ts,js,json}"
        check = "npx biome check --no-errors-on-unmatched {{ files }}"
        fix = "npx biome check --write --no-errors-on-unmatched {{ files }}"
    }
    ["tsc"] {
        glob = "**/*.ts"
        check = "npx tsc --noEmit"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
